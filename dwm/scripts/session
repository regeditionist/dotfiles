#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
WM="$ROOT/build/dwm"
[ -x "$WM" ] || "$ROOT/scripts/build"

# Apply neutral core X pointer acceleration for this DWM session.
"$ROOT/build/pointer-accel" || :

# Restore the user's feh wallpaper for this X11 session.
if [ -r "$HOME/.fehbg" ]; then
	/bin/sh "$HOME/.fehbg"
fi

/usr/bin/dunst &
dunst_pid=$!

"$ROOT/scripts/status" &
status_pid=$!
cleanup() {
	kill "$status_pid" 2>/dev/null || :
	kill "$dunst_pid" 2>/dev/null || :
	wait "$status_pid" 2>/dev/null || :
	wait "$dunst_pid" 2>/dev/null || :
}
trap cleanup EXIT HUP INT TERM

"$WM" &
wm_pid=$!
wait "$wm_pid"
