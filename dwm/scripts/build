#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
SRC="$ROOT/upstream"
OUT="$ROOT/build"

mkdir -p "$OUT"
cp "$SRC/config.def.h" "$SRC/config.h"
make -C "$SRC" clean all
cp "$SRC/dwm" "$OUT/dwm.new"
mv -f "$OUT/dwm.new" "$OUT/dwm"
${CC:-cc} -O2 -Wall -Wextra -o "$OUT/pointer-accel.new" \
	"$ROOT/scripts/pointer-accel.c" -lXi -lX11
mv -f "$OUT/pointer-accel.new" "$OUT/pointer-accel"
printf 'Built DWM and the pointer helper in %s\n' "$OUT"
version_status=0
version=$("$OUT/dwm" -v 2>&1) || version_status=$?
[ "$version_status" -eq 1 ] && [ "$version" = "dwm-6.8" ]
printf '%s\n' "$version"
